declare "component_ntopng" {
	argument "forward_to" {
		comment = "Must be a list(MetricsReceiver) where collected metrics should be forwarded to"
	}

	argument "scrape_interval" {
		optional = true
		default  = "30s"
	}

	argument "scrape_timeout" {
		optional = true
		default  = "10s"
	}

	argument "exporter_target" {
		optional = true
		default  = coalesce(sys.env("NTOPNG_EXPORTER_TARGET"), "ntopng-exporter:7979")
	}

	argument "ntopng_url" {
		optional = true
		default  = coalesce(sys.env("NTOPNG_URL"), "http://ntopng:3002/lua/rest/v2/get/interface/data.lua?ifid=0")
	}

	prometheus.scrape "ntopng" {
		targets = [{
			__address__ = argument.exporter_target.value,
			__param_target = argument.ntopng_url.value,
			__param_module = "default",
			job             = "integrations/network/ntopng",
		}]

		metrics_path = "/probe"

		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value

		forward_to = [prometheus.relabel.ntopng.receiver]
	}

	prometheus.relabel "ntopng" {
		forward_to = argument.forward_to.value
	}
}
