declare "component_ai_monitoring" {
	argument "forward_to" {
		comment = "Must be a list(MetricsReceiver) where collected metrics should be forwarded to"
	}

	argument "scrape_interval" {
		optional = true
		default  = "15s"
	}

	argument "scrape_timeout" {
		optional = true
		default  = "10s"
	}

	argument "enabled" {
		optional = true
		default  = coalesce(sys.env("AI_MONITORING_ENABLED"), "false")
	}

	// DCGM exporter target (Linux/Docker GPU monitoring)
	argument "dcgm_target" {
		optional = true
		default  = coalesce(sys.env("DCGM_EXPORTER_TARGET"), "dcgm-exporter:9400")
	}

	// llama-swap / inference server target (works for any remote host)
	argument "inference_target" {
		optional = true
		default  = coalesce(sys.env("AI_INFERENCE_METRICS_TARGET"), "100.87.47.78:8080")
	}

	// Token metrics target (same as inference if llama-swap exposes token metrics)
	argument "token_target" {
		optional = true
		default  = coalesce(sys.env("AI_TOKEN_METRICS_TARGET"), "100.87.47.78:8080")
	}

	// LLM API target (e.g., ollama) - optional, use inference_target if not needed separately
	argument "llm_api_target" {
		optional = true
		default  = coalesce(sys.env("LLM_API_METRICS_TARGET"), "")
	}

	// Base address of the LLM server for per-model llama-server scrapes
	argument "llama_server_host" {
		optional = true
		default  = coalesce(sys.env("LLAMA_SERVER_HOST"), "100.87.47.78")
	}

	discovery.relabel "ai_targets" {
		targets = [
			{
				__address__  = argument.dcgm_target.value,
				__tmp_enable = argument.enabled.value,
				job          = "integrations/ai/gpu",
				metric_scope = "gpu",
			},
			{
				__address__  = argument.inference_target.value,
				__tmp_enable = argument.enabled.value,
				job          = "integrations/ai/inference-latency",
				metric_scope = "inference_latency",
			},
			{
				__address__  = argument.token_target.value,
				__tmp_enable = argument.enabled.value,
				job          = "integrations/ai/token-generation",
				metric_scope = "token_generation",
			},
		]

		// Only add llm_api target if it has a non-empty value
		rule {
			action        = "keep"
			source_labels = ["__tmp_enable"]
			regex         = "true"
		}
	}

	// Separate relabel for llm_api target (optional)
	discovery.relabel "llm_api_targets" {
		targets = [
			{
				__address__  = argument.llm_api_target.value,
				__tmp_enable = argument.enabled.value,
				job          = "integrations/ai/llm-api",
				metric_scope = "llm_api",
			},
		]

		rule {
			action        = "keep"
			source_labels = ["__tmp_enable"]
			regex         = "true"
		}

		rule {
			action        = "drop"
			source_labels = ["__address__"]
			regex         = "^$"
		}
	}

	prometheus.scrape "ai_targets" {
		targets = discovery.relabel.ai_targets.output

		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value

		forward_to = [prometheus.relabel.ai_targets.receiver]
	}

	// Separate scrape for optional llm_api target
	prometheus.scrape "llm_api_targets" {
		targets = discovery.relabel.llm_api_targets.output

		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value

		forward_to = [prometheus.relabel.llm_api_targets.receiver]
	}

	prometheus.relabel "ai_targets" {
		forward_to = argument.forward_to.value

		rule {
			action        = "keep"
			source_labels = ["__name__"]
			regex         = "(DCGM_FI_DEV_GPU_UTIL|DCGM_FI_DEV_MEM_COPY_UTIL|DCGM_FI_DEV_MEMORY_TEMP|DCGM_FI_DEV_GPU_TEMP|nvidia_gpu.*|nvml_.*|llm_inference_latency_seconds.*|llm_tokens_generated_total|llamaswap_.*|probe_success|up)"
		}
	}

	prometheus.relabel "llm_api_targets" {
		forward_to = argument.forward_to.value

		rule {
			action        = "keep"
			source_labels = ["__name__"]
			regex         = "(llm_inference_latency_seconds.*|llm_tokens_generated_total|probe_success|up)"
		}
	}

	// Per-model llama-server instances managed by llama-swap
	// always-on: 10001, swap group cycles through 10002-10011
	prometheus.scrape "llama_server_ports" {
		targets = [
			{__address__ = argument.llama_server_host.value + ":10001"},
			{__address__ = argument.llama_server_host.value + ":10002"},
			{__address__ = argument.llama_server_host.value + ":10003"},
			{__address__ = argument.llama_server_host.value + ":10004"},
			{__address__ = argument.llama_server_host.value + ":10005"},
			{__address__ = argument.llama_server_host.value + ":10006"},
			{__address__ = argument.llama_server_host.value + ":10007"},
			{__address__ = argument.llama_server_host.value + ":10008"},
			{__address__ = argument.llama_server_host.value + ":10009"},
			{__address__ = argument.llama_server_host.value + ":10010"},
			{__address__ = argument.llama_server_host.value + ":10011"},
		]

		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value

		forward_to = [prometheus.relabel.llama_server_ports.receiver]
	}

	prometheus.relabel "llama_server_ports" {
		forward_to = argument.forward_to.value

		rule {
			target_label = "job"
			replacement  = "integrations/llama-server"
		}

		rule {
			source_labels = ["__address__"]
			target_label  = "instance"
		}

		rule {
			action        = "keep"
			source_labels = ["__name__"]
			regex         = "(llamacpp:.*|llama_.*|up)"
		}
	}
}
